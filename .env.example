BOT_TOKEN=replace_with_telegram_bot_token
# Private archive channel; bot must be its administrator with post permission.
ARCHIVE_CHANNEL_ID=-1004388937618
DATABASE_URL=postgresql+asyncpg://pvp:pvp@postgres:5432/pvp_chat
REDIS_URL=redis://redis:6379/0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_unique_password
PUBLIC_BOT_USERNAME=YourBotUsername
DEFAULT_AVATAR_URL=https://api.dicebear.com/9.x/initials/png?seed=Player
TERMS_VERSION=2026-09-13

# Public HTTPS Mini App URL; Railway also uses RAILWAY_PUBLIC_DOMAIN automatically.
MINI_APP_URL=

# Shared rate limits require reachable private Redis (REDIS_URL above).
SECURITY_MAX_CONCURRENT=100
SECURITY_MAX_UPLOADS=4
DB_STATEMENT_TIMEOUT_MS=5000
# Railway HTTP edge overwrites X-Real-IP. Automatically enabled only when Railway
# supplies both RAILWAY_ENVIRONMENT_ID and RAILWAY_PUBLIC_DOMAIN. No TCP bypass.
SECURITY_TRUST_RAILWAY_EDGE=true
# Custom startup commands must include --no-proxy-headers to preserve socket peers.
